datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  startDate DateTime
  endDate   DateTime
  status    String
  budget    Float
  createdAt DateTime @default(now())

  tasks     Task[]
  resources Resource[]
  risks     RiskPrediction[]
  reports   Report[]
}

model Task {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId       String    @db.ObjectId
  project         Project   @relation(fields: [projectId], references: [id])
  title           String
  priority        String
  estimatedHours  Int
  actualHours     Int       @default(0)
  status          String
  dueDate         DateTime
  assignedTo      String?   @db.ObjectId
  resource        Resource? @relation(fields: [assignedTo], references: [id])
  complexityScore Int       @default(1)

  dependencies TaskDependency[] @relation("TaskDependencies")
  dependentOn  TaskDependency[] @relation("DependentTasks")
  history      TaskHistory[]
}

model Resource {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  role              String
  availabilityHours Int
  skillSet          String
  projectId         String  @db.ObjectId
  project           Project @relation(fields: [projectId], references: [id])

  tasks Task[]
}

model TaskDependency {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  taskId          String @db.ObjectId
  task            Task   @relation("TaskDependencies", fields: [taskId], references: [id])
  dependsOnTaskId String @db.ObjectId
  dependsOnTask   Task   @relation("DependentTasks", fields: [dependsOnTaskId], references: [id])
  dependencyType  String
}

model TaskHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String   @db.ObjectId
  task      Task     @relation(fields: [taskId], references: [id])
  oldStatus String
  newStatus String
  changedAt DateTime @default(now())
  changedBy String
}

model RiskPrediction {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId            String   @db.ObjectId
  project              Project  @relation(fields: [projectId], references: [id])
  riskType             String
  riskScore            Float
  severity             String
  affectedArea         String
  mitigationSuggestion String
  predictedAt          DateTime @default(now())
}

model Report {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String   @db.ObjectId
  project     Project  @relation(fields: [projectId], references: [id])
  reportType  String
  format      String
  filePath    String
  generatedAt DateTime @default(now())
}
